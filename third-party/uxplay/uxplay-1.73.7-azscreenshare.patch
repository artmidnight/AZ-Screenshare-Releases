     } else if (!entry->filled) {
         /* Check how much we have space left in the buffer */
-        if (entry_count < RAOP_BUFFER_LENGTH) {
+        if (entry_count < AZ_RESEND_WAIT) {
             /* Return nothing and hope resend gets on time */
             return NULL;
         }
-        /* Risk of buffer overrun, return empty buffer */
+        /* waited long enough for the resend: skip the missing packet */
+        logger_log(raop_buffer->logger, LOGGER_INFO, "AZAUDIO skipped_missing seq=%u", raop_buffer->first_seqnum);
     }
 
     /* Update buffer and validate entry */
@@ -256,6 +261,10 @@ raop_buffer_dequeue(raop_buffer_t *raop_buffer, unsigned int *length, uint32_t *
         return NULL;
     }
     entry->filled = 0;
+    if (!entry->payload_data) {
+        /* a "no data" packet held this number (see raop_buffer_mark_nodata): nothing to play, go on */
+        return raop_buffer_dequeue(raop_buffer, length, rtp_timestamp, seqnum, no_resend);
+    }
 
     /* Return entry payload buffer */
     *rtp_timestamp = entry->rtp_timestamp;
@@ -267,6 +276,27 @@ raop_buffer_dequeue(raop_buffer_t *raop_buffer, unsigned int *length, uint32_t *
     return data;
 }
 
+/* AZ Screenshare: the client also sends "no data" packets, which use up a sequence number but carry no
+   audio and are not enqueued. Mark that number as done so the buffer does not wait for it to be resent.
+   Returns 1 when the number was inside the waiting window (it would have blocked playback). */
+int raop_buffer_mark_nodata(raop_buffer_t *raop_buffer, unsigned short seqnum) {
+    assert(raop_buffer);
+    if (raop_buffer->is_empty) return 0;
+    if (seqnum_cmp(seqnum, raop_buffer->first_seqnum) < 0) return 0;
+    if (seqnum_cmp(seqnum, raop_buffer->first_seqnum + RAOP_BUFFER_LENGTH) >= 0) return 0;
+    raop_buffer_entry_t *entry = &raop_buffer->entries[seqnum % RAOP_BUFFER_LENGTH];
+    if (entry->filled) return 0;
+    entry->seqnum = seqnum;
+    entry->rtp_timestamp = 0;
+    entry->filled = 1;
+    entry->payload_data = NULL;
+    entry->payload_size = 0;
+    if (seqnum_cmp(seqnum, raop_buffer->last_seqnum) > 0) {
+        raop_buffer->last_seqnum = seqnum;
+    }
+    return 1;
+}
+
