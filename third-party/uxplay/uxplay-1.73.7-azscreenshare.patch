diff --git a/lib/raop_rtp_mirror.c b/lib/raop_rtp_mirror.c
index 2efee1b..6efc850 100644
--- a/lib/raop_rtp_mirror.c
+++ b/lib/raop_rtp_mirror.c
@@ -39,6 +39,46 @@
 #include "utils.h"
 #include "plist/plist.h"
 
+/* AZ Screenshare: once a second, one "AZSTATS" info line with frames per second, data rate,
+   phone-to-PC delay (frame capture time on the phone vs arrival here, clocks synced by NTP),
+   codec and picture size. The app reads it to show live stats. */
+static uint64_t az_window_start = 0;
+static unsigned az_frames = 0;
+static uint64_t az_bytes = 0;
+static int64_t az_delay_sum = 0, az_delay_max = 0;
+static unsigned az_delay_count = 0;
+static int az_width = 0, az_height = 0;
+
+static void az_stats_frame(logger_t *logger, uint64_t now, uint64_t frame_time_local, int bytes, bool h265) {
+    if (!az_window_start) az_window_start = now;
+    az_frames++;
+    az_bytes += (uint64_t) bytes;
+    if (frame_time_local) {
+        /* a frame "arriving before it was captured" means the two clocks differ by a few ms: the delay is ~0 */
+        int64_t d = (int64_t) now - (int64_t) frame_time_local;
+        if (d < 0 && d > -200000000LL) d = 0;
+        if (d >= 0 && d < 10000000000LL) {   /* ignore far-off values (clocks not synced yet) */
+            az_delay_sum += d;
+            az_delay_count++;
+            if (d > az_delay_max) az_delay_max = d;
+        }
+    }
+    uint64_t span = now - az_window_start;
+    if (span >= 1000000000ULL) {
+        double secs = (double) span / 1e9;
+        logger_log(logger, LOGGER_INFO, "AZSTATS fps=%.1f kbps=%.0f delay_ms=%.0f delay_max_ms=%.0f codec=%s width=%d height=%d",
+                   az_frames / secs, (double) az_bytes * 8.0 / 1000.0 / secs,
+                   az_delay_count ? (double) az_delay_sum / az_delay_count / 1e6 : -1.0,
+                   az_delay_count ? (double) az_delay_max / 1e6 : -1.0,
+                   h265 ? "h265" : "h264", az_width, az_height);
+        az_window_start = now;
+        az_frames = 0;
+        az_bytes = 0;
+        az_delay_sum = az_delay_max = 0;
+        az_delay_count = 0;
+    }
+}
+
 #ifdef _WIN32
 #define CAST (char *)
 /* are these keepalive settings for WIN32 correct? */
