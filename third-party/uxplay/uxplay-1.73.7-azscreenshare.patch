+/* AZ Screenshare: how many later packets may arrive while we wait for a missing one to be resent
+   (~0.26 s of AAC-ELD at ~92 packets/s). Upstream waited for a full buffer (256 = ~2.8 s), which played
+   2.8 s of silence at every new video when a packet number was never sent as audio. */
+#define AZ_RESEND_WAIT 24
 
 typedef struct {
     /* Data available */
@@ -243,11 +247,12 @@ raop_buffer_dequeue(raop_buffer_t *raop_buffer, unsigned int *length, uint32_t *
