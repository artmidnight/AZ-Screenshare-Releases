                 }
 
                 raop_rtp_mirror->callbacks.video_process(raop_rtp_mirror->callbacks.cls, raop_rtp_mirror->ntp, &video_data);
+                az_stats_frame(raop_rtp_mirror->logger, raop_ntp_get_local_time(), ntp_timestamp_local, payload_size, h265_video);
                 free(payload_out);
